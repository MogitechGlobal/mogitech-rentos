// apps/api/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PropertyCategory {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
}

enum UnitType {
  APARTMENT
  HOUSE_OWN_COMPOUND
  TOWNHOUSE
  BEDSITTER
  OFFICE
  SHOP
  WAREHOUSE
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // 'ADMIN', 'LANDLORD', 'MANAGER', 'TENANT'
  users       User[]
  permissions Permission[]
  
  @@map("roles")
}

model Permission {
  id      String @id @default(uuid())
  role_id String
  action  String // 'CREATE', 'READ', 'UPDATE', 'DELETE'
  subject String // 'PROPERTIES', 'USERS', 'PAYMENTS'
  
  role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@map("permissions")
}

// UPDATE your existing User model to include the landlord relationship:
model User {
  id            String   @id @default(uuid())
  email         String   @unique

  // --- NEW NEXTAUTH FIELDS ---
  emailVerified DateTime?
  image         String?
  name          String?
  accounts      Account[]
  sessions      Session[]

  password_hash String?
  first_name    String?
  last_name     String?
  role_id       String?
  role          Role?      @relation(fields: [role_id], references: [id])
  is_active     Boolean  @default(true)
  requires_password_change Boolean   @default(false)
  invite_expires_at        DateTime?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  avatar_url    String?  @db.Text
  receive_notifications    Boolean   @default(true)
  requires_2fa             Boolean   @default(false)

  
  landlord      Landlord? 
  tenant        Tenant?

  @@map("users")
}

// Add this below your existing User model in schema.prisma

model Landlord {
  id                  String       @id @default(uuid())
  user_id             String       @unique
  company_name        String
  contact_phone       String
  subscription_status String       @default("STARTER")

  // --- NEW: BILLING CYCLE TRACKING ---
  subscription_cycle  String       @default("MONTHLY") // MONTHLY, QUARTERLY, SEMI_ANNUAL, ANNUAL
  subscription_expiry DateTime?    // Tracks when the account reverts to FREE/SUSPENDED

  // --- DIRECT SETTLEMENT CREDENTIALS ---
  gateway_type        String?   // 'BANK' or 'MPESA'
  bank_name           String?   // 'KCB', 'EQUITY', etc.
  bank_account_number String?

  // --- NEW: DIRECT SETTLEMENT CREDENTIALS ---
  kcb_consumer_key    String?
  kcb_consumer_secret String?
  mpesa_shortcode     String?
  mpesa_passkey       String?

  created_at          DateTime     @default(now())
  updated_at          DateTime     @updatedAt

  business_address    String?   @db.Text
  default_currency    String    @default("KSH")

  company_logo        String?      @db.Text

  user                User         @relation(fields: [user_id], references: [id], onDelete: Cascade)
  
  // We will add relationships to Properties and Tenants in the next modules!
  properties          Property[]
  support_tickets     SupportTicket[]
  platform_invoices   PlatformInvoice[]

  // --- NEW: MARKETPLACE LEADS ---
  listing_leads       ListingLead[]

  
  @@map("landlords")
}

// ADD THESE TO THE BOTTOM OF THE FILE

model Property {
  id          String   @id @default(uuid())
  landlord_id String
  name        String   // e.g., "Sunrise Apartments" or "Downtown Plaza"
  address     String
  type        String   @default("RESIDENTIAL") // RESIDENTIAL or COMMERCIAL
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  landlord    Landlord @relation(fields: [landlord_id], references: [id], onDelete: Cascade)
  units       Unit[]
  announcements Announcement[]
  expenses Expense[]

  @@map("properties")
}

model Unit {
  id          String   @id @default(uuid())
  property_id String
  unit_number String   // e.g., "A1", "Shop 5", "104"
  rent_amount Float    // The monthly cost
  status      String   @default("VACANT") // VACANT, OCCUPIED, MAINTENANCE
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  property    Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  tenants     Tenant[]
  tickets     Ticket[]
  meterReadings MeterReading[]
  maintenance_requests MaintenanceRequest[]

  // --- NEW: MARKETPLACE LISTING FIELDS ---
  is_listed          Boolean  @default(false)
  public_description String?  @db.Text
  amenities          String[] // Postgres Array e.g., ["WiFi", "Borehole", "Balcony"]
  virtual_tour_url   String?

  listing_media      ListingMedia[]
  listing_leads      ListingLead[]

  property_category PropertyCategory @default(RESIDENTIAL)
  unit_type         UnitType         @default(APARTMENT)
  furnishing_status FurnishingStatus @default(UNFURNISHED)
  bedrooms          Int?             // Nullable for commercial spaces
  bathrooms         Float?           // Float allows for 1.5 baths
  size_sqm          Float?           // Square footage/meters
  
  // Relations
  images            UnitImage[]      // Links to the new image gallery model

  @@map("units")
}


model Tenant {
  id          String   @id @default(uuid())
  credit_balance Float    @default(0)
  unit_id     String
  first_name  String
  last_name   String
  email       String   @unique
  phone       String
  emergency_contact_name  String?
  emergency_contact_phone String?
  lease_document LeaseDocument?
  lease_start DateTime
  lease_end   DateTime
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  unit        Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)

  // Add these two new fields for customized document content:
  rules_content      String?  @db.Text
  inspection_content String?  @db.Text

  rules_signature      String?   @db.Text
  rules_signed_at      DateTime?
  inspection_signature String?   @db.Text
  inspection_signed_at DateTime?
 
  rules_landlord_signature      String?   @db.Text
  rules_approved_at             DateTime?
  inspection_landlord_signature String?   @db.Text
  inspection_approved_at        DateTime?
  inspection_notes              String?   @db.Text

  invoices    Invoice[]
  tickets     Ticket[]

  maintenance_requests MaintenanceRequest[] // <-- Add this line!

  // --- NEW: The Authentication Link ---
  user_id     String?   @unique // Optional (?) so existing tenants don't crash the DB
  user        User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@map("tenants")
}

// ADD THESE TO THE BOTTOM OF THE FILE

model Invoice {
  id          String    @id @default(uuid())
  tenant_id   String
  amount      Float
  description String    // e.g., "Rent for March 2026"
  due_date    DateTime
  status      String    @default("UNPAID") // UNPAID, PARTIAL, PAID
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  tenant      Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)
  payments    Payment[]

  @@map("invoices")
}

model Payment {
  id               String   @id @default(uuid())
  invoice_id       String
  amount_paid      Float
  payment_method   String   // e.g., MPESA, BANK_TRANSFER, CASH
  reference_number String?  // e.g., M-Pesa Transaction ID
  payment_date     DateTime @default(now())
  created_at       DateTime @default(now())

  invoice          Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ADD THIS TO THE BOTTOM OF THE FILE

model Ticket {
  id          String   @id @default(uuid())
  title       String
  priority    String   @default("Medium") // High, Medium, Low
  status      String   @default("Reported") // Reported, In Progress, Completed
  unit_id     String
  tenant_id   String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  unit        Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  tenant      Tenant?  @relation(fields: [tenant_id], references: [id], onDelete: SetNull)

  @@map("tickets")
}

model MaintenanceRequest {
  id          String   @id @default(uuid())
  
  // Who requested it and where?
  tenant_id   String?
  tenant      Tenant?   @relation(fields: [tenant_id], references: [id])
  unit_id     String
  unit        Unit     @relation(fields: [unit_id], references: [id])

  // The Details
  issue_type  String   // e.g., PLUMBING, ELECTRICAL, APPLIANCE, GENERAL
  urgency     String   // e.g., LOW, MEDIUM, HIGH, EMERGENCY
  description String   @db.Text
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, RESOLVED

  // --- NEW: RATING FIELDS ---
  rating      Int?     // 1 to 5 stars
  feedback    String?  @db.Text

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("maintenance_requests")
}

model MpesaTransaction {
  id                  String   @id @default(uuid())
  checkout_request_id String   @unique 
  receipt_number      String?  @unique 
  phone_number        String?
  amount              Float?
  status              String   @default("PENDING") 
  raw_payload         Json?
  processed           Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("mpesa_transactions")
}

model Announcement {
  id          String   @id @default(uuid())
  property_id String
  property    Property @relation(fields: [property_id], references: [id])
  title       String
  message     String   @db.Text
  type        String   // 'INFO', 'WARNING', or 'EMERGENCY'
  created_at  DateTime @default(now())

  @@map("announcements")
}

model MeterReading {
  id          String   @id @default(uuid())
  unit_id     String
  unit        Unit     @relation(fields: [unit_id], references: [id])
  utilityType String   // 'water' or 'electricity'
  reading     Float
  created_at  DateTime @default(now())

  @@map("meter_readings")
}

model LeaseDocument {
  id                 String    @id @default(uuid())
  tenant_id          String    @unique
  
  // NEW FIELDS
  type               String    @default("STANDARD") // 'STANDARD' or 'CUSTOM'
  file_url           String?   @db.Text             // URL to the uploaded custom PDF

  status             String    @default("PENDING_SIGNATURE") // PENDING_SIGNATURE, PENDING_APPROVAL, APPROVED
  content            String?   @db.Text             // Made optional for custom uploads
  
  tenant_signature   String?   @db.Text
  signed_at          DateTime?
  
  landlord_signature String?   @db.Text
  approved_at        DateTime?
  
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt

  tenant             Tenant    @relation(fields: [tenant_id], references: [id], onDelete: Cascade)

  @@map("lease_documents")
}

model PlatformIntegration {
  id          String   @id @default(uuid())
  provider    String   @unique // e.g., 'KCB_MPESA', 'PAYSTACK'
  is_active   Boolean  @default(true)
  config      Json     // Stores { consumerKey: '', consumerSecret: '' } securely
  updated_at  DateTime @updatedAt

  @@map("platform_integrations")
}

model GlobalAnnouncement {
  id              String   @id @default(uuid())
  title           String
  content         String   @db.Text
  target_audience String   @default("ALL") // 'ALL', 'LANDLORDS', 'TENANTS'
  is_urgent       Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  @@map("global_announcements")
}

// Add this to the bottom of schema.prisma

model AuditLog {
  id          String   @id @default(uuid())
  admin_id    String
  admin_email String
  action      String   // e.g., 'SUSPEND_USER', 'UPDATE_INTEGRATION', 'IMPERSONATE'
  details     String   @db.Text
  ip_address  String?
  created_at  DateTime @default(now())

  @@map("audit_logs")
}

model SupportTicket {
  id          String   @id @default(uuid())
  landlord_id String
  subject     String
  message     String   @db.Text
  status      String   @default("OPEN") // OPEN, IN_PROGRESS, RESOLVED
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT

  // --- NEW: RATING FIELDS ---
  rating      Int?     // 1 to 5 stars
  feedback    String?  @db.Text

  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  landlord    Landlord @relation(fields: [landlord_id], references: [id], onDelete: Cascade)

  @@map("support_tickets")
}


model SystemSetting {
  id                  String   @id @default("global_settings")
  maintenance_mode    Boolean  @default(false)
  maintenance_message String?  @db.Text
  support_email       String   @default("support@mogitechglobal.com")
  support_phone       String?
  terms_conditions    String?  @db.Text
  updated_at          DateTime @updatedAt

  @@map("system_settings")
}

// --- ADD THIS TO THE BOTTOM OF YOUR SCHEMA ---

model PlatformInvoice {
  id              String   @id @default(uuid())
  landlord_id     String
  amount          Float
  plan_name       String   // e.g., 'BASIC', 'PRO', 'PREMIUM'
  billing_period  String   // e.g., 'April 2026'
  due_date        DateTime
  status          String   @default("UNPAID") // PAID, UNPAID, OVERDUE, CANCELLED
  
  // --- NEW: RECONCILIATION FIELDS ---
  payment_method   String?  // 'MPESA', 'BANK_TRANSFER', 'CASH'
  reference_number String?  // e.g., 'QWE123RTY'
  paid_at         DateTime?
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  landlord        Landlord @relation(fields: [landlord_id], references: [id], onDelete: Cascade)

  @@map("platform_invoices")
}

// --- SYSTEM LOGS & HEALTH ---

model SystemJobLog {
  id                String   @id @default(uuid())
  job_name          String   // e.g., 'SAAS_BILLING_AUTOMATION', 'TENANT_RENT_ROLL'
  status            String   // 'SUCCESS', 'FAILED', 'IN_PROGRESS'
  message           String?  @db.Text
  records_processed Int      @default(0)
  duration_ms       Int?     // Execution time in milliseconds
  created_at        DateTime @default(now())

  @@map("system_job_logs")
}

// --- GLOBAL TEMPLATES ---

model GlobalTemplate {
  id          String   @id @default(uuid())
  name        String   // e.g., 'Standard Lease Agreement'
  type        String   @unique // 'STANDARD_LEASE', 'BUILDING_RULES', 'INSPECTION_REPORT'
  content     String   @db.Text
  is_active   Boolean  @default(true)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("global_templates")
}

// --- MARKETPLACE & CRM MODELS ---

model ListingMedia {
  id          String   @id @default(uuid())
  unit_id     String
  unit        Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  
  url         String   @db.Text
  caption     String?
  is_featured Boolean  @default(false) // Use this to mark the primary thumbnail photo
  
  created_at  DateTime @default(now())

  @@map("listing_media")
}

model ListingLead {
  id             String   @id @default(uuid())
  unit_id        String
  unit           Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  
  // Linking directly to the landlord makes dashboard queries much faster
  landlord_id    String
  landlord       Landlord @relation(fields: [landlord_id], references: [id], onDelete: Cascade)

  prospect_name  String
  prospect_email String
  prospect_phone String
  message        String   @db.Text
  
  // Track the sales pipeline
  status         String   @default("NEW") // NEW, CONTACTED, VIEWED, CONVERTED, ARCHIVED

  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  @@map("listing_leads")
}

model UnitImage {
  id         String   @id @default(uuid())
  unit_id    String
  unit       Unit     @relation(fields: [unit_id], references: [id], onDelete: Cascade)
  url        String   // The URL from your cloud storage (e.g., AWS S3, Cloudinary)
  is_primary Boolean  @default(false) // Used for the main thumbnail on the marketplace
  created_at DateTime @default(now())

  @@map("unit_images")
}

// --- NEXTAUTH REQUIRED MODELS ---

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Expense {
  id            String   @id @default(uuid())
  property_id   String
  amount        Float
  category      String   // e.g., 'MAINTENANCE', 'UTILITIES', 'TAXES', 'INSURANCE', 'SALARY', 'OTHER'
  description   String   @db.Text
  date_incurred DateTime
  receipt_url   String?  @db.Text
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  property      Property @relation(fields: [property_id], references: [id], onDelete: Cascade)

  @@map("expenses")
}